# Copy to .env. Public (EXPO_PUBLIC_) values are bundled into the app: never put secrets here.
#
# Address of the API as seen from the phone. "localhost" is the phone itself, so
# use your computer's LAN address (e.g. http://192.168.1.20:4000/api/v1) or a
# deployed HTTPS URL. Production builds must use HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
